{
  "name": "claude-code-promo-film-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Render a short 3D phone promo clip for your app in code with three.js, Playwright and ffmpeg",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "npx playwright-core install chromium",
    "render": "node scripts/render.mjs",
    "still": "node scripts/render.mjs --still",
    "gif": "node scripts/gif.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=20"
  }
}
